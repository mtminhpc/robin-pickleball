node_modules/
.next/
out/
.env
.env*.local
# Bản sao lưu khi tạm tắt biến Google để chạy thử cục bộ. `.env*.local` KHÔNG
# bắt được `.env.local.bak` vì mẫu đó đòi tên tệp phải kết thúc bằng `.local`,
# mà tệp sao lưu thì chứa nguyên khoá riêng.
.env.local.*
*.bak
*.tsbuildinfo
next-env.d.ts
.vercel
.DS_Store
.data/

# Khoá service account tải từ Google Cloud. Ai có tệp này thì ghi được vào bảng
# tính của bạn, nên nó tuyệt đối không được vào git — mà tên tệp Google đặt sẵn
# lại trông vô hại như mọi tệp JSON khác.
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json
service-account*.json
gcp-*.json
*credentials*.json

# Tệp Google Cloud tải về khi bấm "Download JSON" ở màn hình OAuth client. Nó
# chứa `client_secret`, và tên tệp Google đặt sẵn KHÔNG khớp mẫu nào ở trên: nó
# kết thúc bằng `.apps.googleusercontent.com.json` chứ không phải 12 ký tự hex.
# Đây là lần thứ hai trong dự án một tệp bí mật lọt qua vì tên nó trông vô hại —
# lần trước là `.env.local.bak`. Thêm mới thì kiểm lại `git check-ignore`.
client_secret*.json
